# "Chave do cofre" — Machine Identity read-only do Infisical (Universal Auth).
# Copie para infisical-identity.env na VPS (chmod 600) e preencha com os valores da
# Machine Identity `easyfood-api-prod` criada no projeto `easyfood-api`.
# NUNCA versionar o arquivo real (só este .example).
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_API_URL=https://vault.easysoftcloud.com.br/api
